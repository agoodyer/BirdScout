{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "paths": {
      "@/*": ["./*"]
    },
    "module": "esnext",               // ✔ needed for import assertions
    "target": "esnext",               // ✔ modern JS
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",       // ✔ resolves .json modules properly
    "resolveJsonModule": true,        // ✔ allows importing JSON
    "allowSyntheticDefaultImports": true // ✔ avoids weird import errors
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
